# Telegram Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram ID(s) (comma-separated if multiple: 12345678,87654321)
ADMIN_IDS=123456789

# Database path (default: ./data/contest.db)
DB_PATH=./data/contest.db

# Webhook configuration (For Docker + Caddy deployment)
USE_WEBHOOK=false
DOMAIN=yourdomain.com
PORT=3000
WEBHOOK_SECRET=your_random_secret_token_here
